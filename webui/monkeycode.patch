diff --git a/src/features/providers/monkeycode.ts b/src/features/providers/monkeycode.ts
new file mode 100644
index 0000000..5b40f13
--- /dev/null
+++ b/src/features/providers/monkeycode.ts
@@ -0,0 +1,45 @@
+import type { ApiCallRequest } from '@/services/api/apiCall';
+import type { ProviderBrand } from './types';
+import { PROVIDER_DESCRIPTORS } from './descriptors';
+
+const SYSTEM_PROMPT = 'You are a helpful assistant.';
+
+export function monkeyCodeCredentialsValid(
+  secret: string | undefined,
+  baseUrl: string,
+  keys: string[]
+): boolean {
+  return (
+    !secret ||
+    (Boolean(secret.trim()) &&
+      Boolean(baseUrl.trim()) &&
+      keys.filter((key) => key.trim()).length === 1)
+  );
+}
+
+// Send the current draft secret separately from the upstream body. An explicit
+// empty value disables signing even when the saved credential has a secret.
+export function monkeyCodeProbe(
+  brand: ProviderBrand,
+  secret: string | undefined,
+  body: Record<string, unknown>
+): Pick<ApiCallRequest, 'signingSecret' | 'data'> {
+  if (!PROVIDER_DESCRIPTORS[brand].supportsMonkeyCode || secret === undefined)
+    return { data: JSON.stringify(body) };
+  const payload = { ...body };
+  if (secret) {
+    payload.stream = true;
+    if (brand === 'claude') {
+      payload.system = SYSTEM_PROMPT;
+    } else if (brand === 'codex') {
+      payload.instructions = SYSTEM_PROMPT;
+      payload.input = [{ role: 'user', content: 'hi' }];
+    } else {
+      payload.messages = [
+        { role: 'system', content: SYSTEM_PROMPT },
+        ...((body.messages as unknown[]) ?? []),
+      ];
+    }
+  }
+  return { signingSecret: secret ?? '', data: JSON.stringify(payload) };
+}
