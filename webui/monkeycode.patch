+
+describe('MonkeyCode provider settings', () => {
+  for (const section of ['codex-api-key', 'claude-api-key', 'openai-compatibility']) {
+    it(`round-trips and explicitly clears ${section} without changing other records`, async () => {
+      const raw =
+        section === 'openai-compatibility'
+          ? {
+              name: 'test',
+              'base-url': 'https://example.test/v1',
+              'api-key-entries': [{ 'api-key': 'paired-key' }],
+              signing_secret: 'omas_完整 raw',
+              future: 'keep',
+            }
+          : {
+              'api-key': 'paired-key',
+              'base-url': 'https://example.test/v1',
+              signing_secret: 'omas_完整 raw',
+              future: 'keep',
+            };
+      let rows: unknown[] = [raw, { ...raw, 'api-key': 'other', name: 'other' }];
+      const other = rows[1];
+      apiClient.get = (async () => ({ [section]: rows })) as typeof apiClient.get;
+      apiClient.put = (async (_path: string, body: unknown) => {
+        rows = body as unknown[];
+      }) as typeof apiClient.put;
+      for (const secret of ['omas_完整 raw', 'omas_rotated', '']) {
+        if (section === 'openai-compatibility') {
+          const config = normalizeOpenAIProvider(rows[0])!;
+          assert.equal(config.signingSecret, (rows[0] as typeof raw).signing_secret);
+          await providersApi.updateOpenAIProvider('test', 0, { ...config, signingSecret: secret });
+        } else {
+          const config = normalizeProviderKeyConfig(rows[0])!;
+          assert.equal(config.signingSecret, (rows[0] as typeof raw).signing_secret);
+          const save =
+            section === 'codex-api-key'
+              ? providersApi.updateCodexConfig
+              : providersApi.updateClaudeConfig;
+          await save(config.apiKey, config.baseUrl, { ...config, signingSecret: secret });
+        }
+        assert.equal((rows[0] as typeof raw).signing_secret, secret);
+        assert.equal((rows[0] as typeof raw).future, 'keep');
+        assert.deepEqual(rows[1], other);
+      }
+    });
+  }
+  it('requires one key and explicit base URL only when signing is enabled', () => {
+    assert.equal(monkeyCodeCredentialsValid('omas_test', 'https://test', ['a']), true);
+    assert.equal(monkeyCodeCredentialsValid('omas_test', 'https://test', ['a', 'b']), false);
+    assert.equal(monkeyCodeCredentialsValid('omas_test', '', ['a']), false);
+    assert.equal(monkeyCodeCredentialsValid('  ', 'https://test', ['a']), false);
+    assert.equal(monkeyCodeCredentialsValid('', '', []), true);
+  });
+});
+
+describe('MonkeyCode current draft model tests', () => {
+  for (const brand of ['openaiCompatibility', 'codex', 'claude'] as const) {
+    it(`${brand}: sends the raw draft secret, valid prompt and SSE body; clear overrides saved secret`, async () => {
+      const payloads: Record<string, unknown>[] = [];
+      apiClient.post = (async (_path: string, body: unknown) => {
+        payloads.push(body as Record<string, unknown>);
+        return { status_code: 200, body: 'data: [DONE]\n\n' };
+      }) as typeof apiClient.post;
+      const body = {
+        model: 'test',
+        messages: [{ role: 'user', content: 'hi' }],
+        input: 'hi',
+        stream: false,
+      };
+      for (const secret of ['omas_draft raw', '']) {
+        const probe = monkeyCodeProbe(brand, secret, body);
+        await apiCallApi.request({
+          authIndex: 'saved-auth',
+          method: 'POST',
+          url: 'https://test/v1/test',
+          ...probe,
+        });
+        const call = payloads.at(-1)!;
+        assert.equal(call.signing_secret, secret);
+        assert.equal(call.signingSecret, undefined);
+        const data = JSON.parse(call.data as string);
+        if (secret) {
+          assert.equal(data.stream, true);
+          if (brand === 'claude') assert.equal(data.system, 'You are a helpful assistant.');
+          else if (brand === 'codex') {
+            assert.equal(data.instructions, 'You are a helpful assistant.');
+            assert.ok(Array.isArray(data.input));
+          } else
+            assert.deepEqual(data.messages[0], {
+              role: 'system',
+              content: 'You are a helpful assistant.',
+            });
+        } else assert.deepEqual(data, body);
+      }
+    });
+  }
+  it('preserves omitted draft settings and unsupported providers', () => {
+    assert.deepEqual(monkeyCodeProbe('codex', undefined, { test: true }), {
+      data: '{"test":true}',
+    });
+    assert.deepEqual(monkeyCodeProbe('gemini', undefined, { test: true }), {
+      data: '{"test":true}',
+    });
+  });
+});
